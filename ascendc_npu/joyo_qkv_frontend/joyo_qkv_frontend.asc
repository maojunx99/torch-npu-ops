#ifndef K_MAX_SHAPE_DIM
#define K_MAX_SHAPE_DIM 0
#endif
#include <cstdint>

#include "catlass/arch/arch.hpp"
#include "catlass/arch/resource.hpp"
#include "catlass/gemm/block/block_mmad.hpp"
#include "catlass/gemm/dispatch_policy.hpp"
#include "catlass/gemm/gemm_type.hpp"
#include "catlass/layout/layout.hpp"

namespace {
// Each Cube owns two bounded tiles, shared with its two Vector subcores.
// The runtime Q/KV head geometry determines padded weight columns. Padding
// never contributes to QK/V/gate. FIX rounds FP32 accumulators to BF16
// before the Vector sigmoid, preserving the original rounding boundary.
template <int32_t TileM, int32_t TileN, int32_t TileK>
class QkvgCv final {
 public:
  using ArchTag = Catlass::Arch::AtlasA2;
  using A = Catlass::Gemm::GemmType<bfloat16_t, Catlass::layout::RowMajor>;
  using B = Catlass::Gemm::GemmType<bfloat16_t, Catlass::layout::ColumnMajor>;
  using C = Catlass::Gemm::GemmType<bfloat16_t, Catlass::layout::RowMajor>;
  using L1 = Catlass::GemmShape<TileM, TileN, TileK>;
  using L0 = Catlass::GemmShape<TileM, TileN, 64>;
  using Policy = Catlass::Gemm::MmadAtlasA2Pingpong<true>;
  using Block = Catlass::Gemm::Block::BlockMmad<Policy, L1, L0, A, B, C>;
  struct Params {
    GM_ADDR x;
    GM_ADDR w;
    GM_ADDR qk;
    GM_ADDR v;
    GM_ADDR gate;
    GM_ADDR workspace;
    int32_t rows;
    GM_ADDR qw;
    GM_ADDR kw;
    GM_ADDR freqs;
    GM_ADDR prepared_v;
    int32_t first_length;
    int32_t q_heads;
    int32_t kv_heads;
    int32_t padded_columns;
    int32_t k_shift = 0;
  };
  using Arguments = Params;
  static bool CanImplement(const Arguments& args) { return args.rows > 0; }
  static size_t GetWorkspaceSize(const Arguments&) {
    return 24 * 2 * TileM * TileN * sizeof(bfloat16_t);
  }
  static Params ToUnderlyingArguments(const Arguments& args, uint8_t*) {
    return args;
  }
  template <int32_t Core = g_coreType>
  CATLASS_DEVICE void operator()(const Params& p) {
    if constexpr (Core == AscendC::AIC) {
      cube(p);
    }
    if constexpr (Core == AscendC::AIV) {
      vector(p);
    }
  }

  CATLASS_DEVICE void post_only(const Params& p) {
    constexpr int32_t half_rows = TileM / 2;
    auto tile = resource_.ubBuf.template GetBufferByByte<bfloat16_t>(0);
    constexpr int32_t tile_bytes = half_rows * TileN * sizeof(bfloat16_t);
    auto value = resource_.ubBuf.template GetBufferByByte<float>(tile_bytes);
    auto ones = resource_.ubBuf.template GetBufferByByte<float>(
        tile_bytes + half_rows * 128 * sizeof(float));
    auto sigmoid = resource_.ubBuf.template GetBufferByByte<bfloat16_t>(
        tile_bytes + 2 * half_rows * 128 * sizeof(float));
    AscendC::GlobalTensor<bfloat16_t> workspace, qk, v, gate;
    workspace.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.x));
    qk.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.qk));
    v.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.prepared_v));
    gate.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.gate));
    const int32_t core = AscendC::GetBlockIdx();

    const int32_t core_count = AscendC::GetBlockNum();
    const int32_t column_tiles = (p.padded_columns + TileN - 1) / TileN;
    const int32_t tasks = ((p.rows + half_rows - 1) / half_rows) * column_tiles;
    int32_t iteration = 0;
    for (int32_t task = core; task < tasks; task += core_count, ++iteration) {
      const int32_t row = (task / column_tiles) * half_rows;
      const int32_t column = (task % column_tiles) * TileN;
      const int32_t valid_rows =
          (p.rows <= row
               ? 0
               : (p.rows - row < half_rows ? p.rows - row : half_rows));
      // The preceding epilogue/output must finish before this UB tile is
      // reused.
      AscendC::PipeBarrier<PIPE_ALL>();
      if (valid_rows > 0) {
        const int64_t offset =
            static_cast<int64_t>(row) * p.padded_columns + column;
        const int32_t gate_start = (p.q_heads + 2 * p.kv_heads) * 128;
        const int32_t width =
            column >= gate_start ? p.padded_columns - gate_start : TileN;
        const AscendC::DataCopyParams copy{
            static_cast<uint16_t>(valid_rows),
            static_cast<uint16_t>(width * 2 / 32),
            static_cast<uint16_t>((p.padded_columns - width) * 2 / 32),
            0};
        AscendC::DataCopy(tile, workspace[offset], copy);
      }
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
      if (valid_rows > 0) {
        const int32_t gate_start = (p.q_heads + 2 * p.kv_heads) * 128;
        if (column < gate_start) {
          const int32_t kv_column = column / 128 - p.q_heads;
          if (column < p.q_heads * 128 || kv_column % 2 == 0) {
            prepare_head(p, tile, row, valid_rows, column);
          } else {
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            store_head(p, p.prepared_v, tile, row, valid_rows, kv_column / 2);
          }
        } else {
          const int32_t width = p.padded_columns - gate_start;
          const uint32_t count = valid_rows * width;
          AscendC::Cast(value, tile, AscendC::RoundMode::CAST_NONE, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Muls(value, value, -1.0f, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Exp(value, value, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Adds(value, value, 1.0f, count);
          AscendC::Duplicate(ones, 1.0f, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Div(value, ones, value, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Cast(sigmoid, value, AscendC::RoundMode::CAST_RINT, count);
          AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
          AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
          const AscendC::DataCopyExtParams copy{
              static_cast<uint16_t>(valid_rows),
              static_cast<uint32_t>(p.q_heads * 2),
              0,
              0,
              0};
          AscendC::DataCopyPad(
              gate[static_cast<int64_t>(row) * p.q_heads], sigmoid, copy);
        }
      }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
  }

 private:
  // Match the installed MatMulV2 ShiftBlockAccess pass. The K=6144
  // reduction contains twelve 512-element outer blocks; odd logical
  // partitions reverse those blocks, preserving forward order inside each.
  CATLASS_DEVICE uint32_t native_k_order(const Params& p,
                                         int32_t row,
                                         int32_t column) {
    if (p.k_shift == 0 || p.rows >= 4096) return 0;
    int32_t index = 0;
    int32_t extent = 0;
    bool overlap = false;
    if (p.rows <= 48) {
      index = column / 448;
      extent = 23;
      overlap = index >= 21;
    } else if (p.rows == 737 || p.rows == 738) {
      index = row / 128;
      extent = 6;
      overlap = index >= 4;
    } else if (p.rows == 807 || p.rows == 808) {
      index = column / 896;
      extent = 12;
      overlap = index >= 10;
    }
    if (extent < 4 || extent > 25 || overlap) return 0;
    const uint32_t offset = (12 / (extent / 2)) * ((index / 2) % (extent / 2));
    return offset | ((index % 2) ? 256U : 0U);
  }

  CATLASS_DEVICE void cube(const Params& p) {
    if (p.k_shift != 0 && p.rows <= 48) {
      cube_tiles<64>(p);
    } else {
      cube_tiles<128>(p);
    }
  }

  template <int32_t ComputeN>
  CATLASS_DEVICE void cube_tiles(const Params& p) {
    using NativeL1 = Catlass::GemmShape<TileM, ComputeN, TileK>;
    using NativeL0 = Catlass::GemmShape<TileM, ComputeN, 64>;
    using NativeBlock =
        Catlass::Gemm::Block::BlockMmad<Policy, NativeL1, NativeL0, A, B, C>;
    NativeBlock block(resource_);
    AscendC::GlobalTensor<bfloat16_t> x, w, workspace;
    x.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.x));
    w.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.w));
    workspace.SetGlobalBuffer(
        reinterpret_cast<__gm__ bfloat16_t*>(p.workspace));
    const int32_t core = AscendC::GetBlockIdx();
    const int32_t core_count = AscendC::GetBlockNum();
    const int32_t row_tiles = (p.rows + TileM - 1) / TileM;
    const int32_t column_tiles = (p.padded_columns + TileN - 1) / TileN;
    const Catlass::layout::RowMajor layout_a(p.rows, 6144);
    const Catlass::layout::ColumnMajor layout_b(6144, p.padded_columns);
    const Catlass::layout::RowMajor layout_c(TileM, TileN);
    int32_t iteration = 0;
    for (int32_t task = core; task < row_tiles * column_tiles;
         task += core_count, ++iteration) {
      const int32_t row = (task / column_tiles) * TileM;
      const int32_t column = (task % column_tiles) * TileN;
      const int32_t valid_rows = (p.rows - row < TileM ? p.rows - row : TileM);
      const int32_t slot = iteration % 2;
      AscendC::CrossCoreWaitFlag(2 + slot);
      // The two 64-column Cube tiles are internal to this same mixed kernel.
      // They rejoin the original 128-column head before its Vector RMS/RoPE.
      for (int32_t inner = 0; inner < TileN; inner += ComputeN) {
        const int32_t start_column = column + inner;
        if (start_column >= p.padded_columns) break;
        const int32_t valid_cols = (p.padded_columns - start_column < ComputeN
                                        ? p.padded_columns - start_column
                                        : ComputeN);
        block(x[static_cast<int64_t>(row) * 6144],
              layout_a,
              w[static_cast<int64_t>(start_column) * 6144],
              layout_b,
              workspace[(core * 2 + slot) * TileM * TileN + inner],
              layout_c,
              Catlass::GemmCoord(valid_rows, valid_cols, 6144),
              native_k_order(p, row, start_column));
      }
      AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(slot);
    }
    AscendC::CrossCoreWaitFlag(2);
    AscendC::CrossCoreWaitFlag(3);
    AscendC::PipeBarrier<PIPE_ALL>();
  }

  CATLASS_DEVICE void vector(const Params& p) {
    constexpr int32_t half_rows = TileM / 2;
    auto tile = resource_.ubBuf.template GetBufferByByte<bfloat16_t>(0);
    constexpr int32_t tile_bytes = half_rows * TileN * sizeof(bfloat16_t);
    auto value = resource_.ubBuf.template GetBufferByByte<float>(tile_bytes);
    auto ones = resource_.ubBuf.template GetBufferByByte<float>(
        tile_bytes + half_rows * 128 * sizeof(float));
    auto sigmoid = resource_.ubBuf.template GetBufferByByte<bfloat16_t>(
        tile_bytes + 2 * half_rows * 128 * sizeof(float));
    AscendC::GlobalTensor<bfloat16_t> workspace, qk, v, gate;
    workspace.SetGlobalBuffer(
        reinterpret_cast<__gm__ bfloat16_t*>(p.workspace));
    qk.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.qk));
    v.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.prepared_v));
    gate.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.gate));
    const int32_t core = AscendC::GetBlockIdx() / AscendC::GetSubBlockNum();
    const int32_t subcore = AscendC::GetSubBlockIdx();
    const int32_t core_count = AscendC::GetBlockNum();
    const int32_t column_tiles = (p.padded_columns + TileN - 1) / TileN;
    const int32_t tasks = ((p.rows + TileM - 1) / TileM) * column_tiles;
    AscendC::CrossCoreSetFlag<0x2, PIPE_MTE2>(2);
    AscendC::CrossCoreSetFlag<0x2, PIPE_MTE2>(3);
    int32_t iteration = 0;
    for (int32_t task = core; task < tasks; task += core_count, ++iteration) {
      const int32_t row = (task / column_tiles) * TileM + subcore * half_rows;
      const int32_t column = (task % column_tiles) * TileN;
      const int32_t valid_rows =
          (p.rows <= row
               ? 0
               : (p.rows - row < half_rows ? p.rows - row : half_rows));
      const int32_t slot = iteration % 2;
      AscendC::CrossCoreWaitFlag(slot);
      // The preceding epilogue/output must finish before this UB tile is
      // reused.
      AscendC::PipeBarrier<PIPE_ALL>();
      if (valid_rows > 0) {
        const int64_t offset =
            (core * 2 + slot) * TileM * TileN + subcore * half_rows * TileN;
        const int32_t gate_start = (p.q_heads + 2 * p.kv_heads) * 128;
        const int32_t width =
            column >= gate_start ? p.padded_columns - gate_start : TileN;
        const AscendC::DataCopyParams copy{
            static_cast<uint16_t>(valid_rows),
            static_cast<uint16_t>(width * 2 / 32),
            static_cast<uint16_t>((TileN - width) * 2 / 32),
            0};
        AscendC::DataCopy(tile, workspace[offset], copy);
      }
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
      // Release only after both Vector subcores have copied their rows.
      AscendC::CrossCoreSetFlag<0x2, PIPE_MTE2>(2 + slot);
      if (valid_rows > 0) {
        const int32_t gate_start = (p.q_heads + 2 * p.kv_heads) * 128;
        if (column < gate_start) {
          const int32_t kv_column = column / 128 - p.q_heads;
          if (column < p.q_heads * 128 || kv_column % 2 == 0) {
            prepare_head(p, tile, row, valid_rows, column);
          } else {
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            store_head(p, p.prepared_v, tile, row, valid_rows, kv_column / 2);
          }
        } else {
          const int32_t width = p.padded_columns - gate_start;
          const uint32_t count = valid_rows * width;
          AscendC::Cast(value, tile, AscendC::RoundMode::CAST_NONE, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Muls(value, value, -1.0f, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Exp(value, value, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Adds(value, value, 1.0f, count);
          AscendC::Duplicate(ones, 1.0f, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Div(value, ones, value, count);
          AscendC::PipeBarrier<PIPE_V>();
          AscendC::Cast(sigmoid, value, AscendC::RoundMode::CAST_RINT, count);
          AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
          AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
          const AscendC::DataCopyExtParams copy{
              static_cast<uint16_t>(valid_rows),
              static_cast<uint32_t>(p.q_heads * 2),
              0,
              0,
              0};
          AscendC::DataCopyPad(
              gate[static_cast<int64_t>(row) * p.q_heads], sigmoid, copy);
        }
      }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
  }
  // Batch 32 rows: reduce and broadcast entirely on Vector, with no scalar
  // GetValue rendezvous. Only sample boundaries split the final DMA stores.
  CATLASS_DEVICE void store_head(const Params& p,
                                 GM_ADDR destination,
                                 const AscendC::LocalTensor<bfloat16_t>& source,
                                 int32_t row,
                                 int32_t rows,
                                 int32_t head) {
    AscendC::GlobalTensor<bfloat16_t> output;
    output.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(destination));
    const int32_t output_heads = destination == p.qk ? p.q_heads : p.kv_heads;
    const AscendC::DataCopyParams copy{
        static_cast<uint16_t>(rows),
        8,
        0,
        static_cast<uint16_t>((output_heads - 1) * 8)};
    const int64_t offset =
        (static_cast<int64_t>(row) * output_heads + head) * 128;
    AscendC::DataCopy(output[offset], source, copy);
  }
  CATLASS_DEVICE void prepare_head(const Params& p,
                                   const AscendC::LocalTensor<bfloat16_t>& tile,
                                   int32_t row,
                                   int32_t rows,
                                   int32_t column) {
    constexpr int32_t batch = 32;
    constexpr int32_t count = batch * 128;
    constexpr int32_t plane = batch * 64;
    constexpr int32_t base = 32768;
    auto value = resource_.ubBuf.template GetBufferByByte<float>(base);
    auto squares =
        resource_.ubBuf.template GetBufferByByte<float>(base + 16384);
    auto frequency =
        resource_.ubBuf.template GetBufferByByte<float>(base + 32768);
    auto frequency_bf16 =
        resource_.ubBuf.template GetBufferByByte<bfloat16_t>(base + 49152);
    auto normalized =
        resource_.ubBuf.template GetBufferByByte<bfloat16_t>(base + 57344);
    auto products =
        resource_.ubBuf.template GetBufferByByte<float>(base + 65536);
    auto rounded =
        resource_.ubBuf.template GetBufferByByte<bfloat16_t>(base + 98304);
    auto output =
        resource_.ubBuf.template GetBufferByByte<bfloat16_t>(base + 114688);
    auto weight_bf16 =
        resource_.ubBuf.template GetBufferByByte<bfloat16_t>(base + 122880);
    auto weight =
        resource_.ubBuf.template GetBufferByByte<float>(base + 123136);
    auto sum = resource_.ubBuf.template GetBufferByByte<float>(base + 123648);
    auto ones = resource_.ubBuf.template GetBufferByByte<float>(base + 123904);
    auto inverse =
        resource_.ubBuf.template GetBufferByByte<float>(base + 124160);
    AscendC::GlobalTensor<bfloat16_t> weights;
    weights.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(
        column < p.q_heads * 128 ? p.qw : p.kw));
    AscendC::GlobalTensor<float> frequencies;
    frequencies.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(p.freqs));
    AscendC::DataCopy(weight_bf16, weights, 128);
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
    AscendC::Cast(weight, weight_bf16, AscendC::RoundMode::CAST_NONE, 128);
    AscendC::Duplicate(ones, 1.0f, 64);
    AscendC::PipeBarrier<PIPE_V>();
    for (int32_t local_row = 0; local_row < rows; local_row += batch) {
      AscendC::PipeBarrier<PIPE_ALL>();
      const int32_t active =
          rows - local_row < batch ? rows - local_row : batch;
      AscendC::DataCopy(
          frequency,
          frequencies[static_cast<int64_t>(row + local_row) * 128],
          active * 128);
      AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
      AscendC::Duplicate(value, 0.0f, count);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast(value,
                    tile[local_row * 128],
                    AscendC::RoundMode::CAST_NONE,
                    active * 128);
      AscendC::Cast(
          frequency_bf16, frequency, AscendC::RoundMode::CAST_RINT, count);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast(
          frequency, frequency_bf16, AscendC::RoundMode::CAST_NONE, count);
      AscendC::Mul(squares, value, value, count);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Add<float, true>(
          squares,
          squares,
          squares[64],
          static_cast<uint64_t>(64),
          batch,
          AscendC::BinaryRepeatParams(1, 1, 1, 16, 16, 16));
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::WholeReduceSum<float, true>(
          sum, squares, static_cast<uint64_t>(64), batch, 1, 1, 16);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Muls(sum, sum, 1.0f / 128, batch);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Adds(sum, sum, 1e-6f, batch);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Sqrt(sum, sum, batch);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Div(sum, ones, sum, batch);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Brcb(inverse, sum, 4, AscendC::BrcbRepeatParams(1, 8));
      AscendC::PipeBarrier<PIPE_V>();
      // Four groups of eight rows, each row's reciprocal repeated in a block.
      for (int32_t group = 0; group < batch; group += 8) {
        AscendC::Mul<float, true>(
            value[group * 128],
            value[group * 128],
            inverse[group * 8],
            static_cast<uint64_t>(64),
            16,
            AscendC::BinaryRepeatParams(16, 16, 1, 1, 1, 0));
      }
      AscendC::PipeBarrier<PIPE_V>();
      for (int32_t half = 0; half < 2; ++half) {
        AscendC::Mul<float, true>(
            value[half * 64],
            value[half * 64],
            weight[half * 64],
            static_cast<uint64_t>(64),
            batch,
            AscendC::BinaryRepeatParams(1, 1, 1, 16, 16, 0));
      }
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast(normalized, value, AscendC::RoundMode::CAST_RINT, count);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast(value, normalized, AscendC::RoundMode::CAST_NONE, count);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Mul<float, true>(
          products,
          value,
          frequency,
          static_cast<uint64_t>(64),
          batch,
          AscendC::BinaryRepeatParams(1, 1, 1, 8, 16, 16));
      AscendC::Mul<float, true>(
          products[plane],
          value[64],
          frequency[64],
          static_cast<uint64_t>(64),
          batch,
          AscendC::BinaryRepeatParams(1, 1, 1, 8, 16, 16));
      AscendC::Mul<float, true>(
          products[2 * plane],
          value[64],
          frequency,
          static_cast<uint64_t>(64),
          batch,
          AscendC::BinaryRepeatParams(1, 1, 1, 8, 16, 16));
      AscendC::Mul<float, true>(
          products[3 * plane],
          value,
          frequency[64],
          static_cast<uint64_t>(64),
          batch,
          AscendC::BinaryRepeatParams(1, 1, 1, 8, 16, 16));
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast(
          rounded, products, AscendC::RoundMode::CAST_RINT, 4 * plane);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast(
          products, rounded, AscendC::RoundMode::CAST_NONE, 4 * plane);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Sub(products, products, products[plane], plane);
      AscendC::Add(
          products[plane], products[2 * plane], products[3 * plane], plane);
      AscendC::PipeBarrier<PIPE_V>();
      AscendC::Cast<bfloat16_t, float, true>(
          output,
          products,
          AscendC::RoundMode::CAST_RINT,
          static_cast<uint64_t>(64),
          batch,
          AscendC::UnaryRepeatParams(1, 1, 8, 8));
      AscendC::Cast<bfloat16_t, float, true>(
          output[64],
          products[plane],
          AscendC::RoundMode::CAST_RINT,
          static_cast<uint64_t>(64),
          batch,
          AscendC::UnaryRepeatParams(1, 1, 8, 8));
      AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
      AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
      store_head(p,
                 column < p.q_heads * 128 ? p.qk : p.v,
                 output,
                 row + local_row,
                 active,
                 column < p.q_heads * 128 ? column / 128
                                          : (column / 128 - p.q_heads) / 2);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
  }
  Catlass::Arch::Resource<ArchTag> resource_;
};
template <class Operation>
__global__ __mix__(1, 2) void cv_entry(typename Operation::Params params,
                                       uint64_t sync_addr) {
  AscendC::SetSyncBaseAddr(sync_addr);
  Operation operation;
  operation(params);
}
template <class Operation>
__global__ __aicore__ void post_entry(typename Operation::Params params) {
  Operation operation;
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIV_ONLY);
  operation.post_only(params);
}
}  // namespace

extern "C" int32_t joyo_qkv_frontend_prepare(void* x,
                                             void* w,
                                             void* qk,
                                             void* v,
                                             void* gate,
                                             void* workspace,
                                             void* stream,
                                             uint64_t sync_addr,
                                             int32_t rows,
                                             int32_t q_heads,
                                             int32_t kv_heads,
                                             void* qw,
                                             void* kw,
                                             void* freqs,
                                             void* prepared_v,
                                             int32_t first_length) {
  if (!x || !w || !qk || !v || !gate || !workspace || !sync_addr || rows <= 0 ||
      q_heads <= 0 || q_heads > 128 || kv_heads <= 0 ||
      q_heads % kv_heads != 0 || !qw || !kw || !freqs || !prepared_v ||
      first_length <= 0 || first_length > rows) {
    return 2;
  }
  using Kernel = QkvgCv<128, 128, 256>;
  Kernel::Arguments arguments{
      reinterpret_cast<uint8_t*>(x),
      reinterpret_cast<uint8_t*>(w),
      reinterpret_cast<uint8_t*>(qk),
      reinterpret_cast<uint8_t*>(v),
      reinterpret_cast<uint8_t*>(gate),
      reinterpret_cast<uint8_t*>(workspace),
      rows,
      reinterpret_cast<uint8_t*>(qw),
      reinterpret_cast<uint8_t*>(kw),
      reinterpret_cast<uint8_t*>(freqs),
      reinterpret_cast<uint8_t*>(prepared_v),
      first_length,
      q_heads,
      kv_heads,
      (q_heads + 2 * kv_heads) * 128 + ((q_heads + 15) / 16) * 16};
  cv_entry<Kernel><<<24, nullptr, stream>>>(arguments, sync_addr);
  return 0;
}

extern "C" int32_t joyo_qkv_post_prepare(void* projection,
                                         void* q,
                                         void* k,
                                         void* v,
                                         void* gate,
                                         void* stream,
                                         int32_t rows,
                                         int32_t qh,
                                         int32_t kvh,
                                         void* qw,
                                         void* kw,
                                         void* frequencies) {
  if (!projection || !q || !k || !v || !gate || !qw || !kw || !frequencies ||
      rows <= 0 || qh <= 0 || qh > 128 || qh % 16 != 0 || kvh <= 0 ||
      qh % kvh != 0)
    return 2;
  using Kernel = QkvgCv<128, 128, 256>;
  Kernel::Params params{reinterpret_cast<uint8_t*>(projection),
                        nullptr,
                        reinterpret_cast<uint8_t*>(q),
                        reinterpret_cast<uint8_t*>(k),
                        reinterpret_cast<uint8_t*>(gate),
                        nullptr,
                        rows,
                        reinterpret_cast<uint8_t*>(qw),
                        reinterpret_cast<uint8_t*>(kw),
                        reinterpret_cast<uint8_t*>(frequencies),
                        reinterpret_cast<uint8_t*>(v),
                        rows,
                        qh,
                        kvh,
                        (qh + 2 * kvh) * 128 + qh};
  post_entry<Kernel><<<48, nullptr, stream>>>(params);
  return 0;
}

extern "C" int32_t joyo_qkv_frontend_prepare_shift(void* x,
                                                   void* w,
                                                   void* qk,
                                                   void* v,
                                                   void* gate,
                                                   void* workspace,
                                                   void* stream,
                                                   uint64_t sync_addr,
                                                   int32_t rows,
                                                   int32_t q_heads,
                                                   int32_t kv_heads,
                                                   void* qw,
                                                   void* kw,
                                                   void* freqs,
                                                   void* prepared_v,
                                                   int32_t first_length,
                                                   int32_t k_shift) {
  if (!x || !w || !qk || !v || !gate || !workspace || !sync_addr || rows <= 0 ||
      q_heads <= 0 || q_heads > 128 || kv_heads <= 0 ||
      q_heads % kv_heads != 0 || !qw || !kw || !freqs || !prepared_v ||
      first_length <= 0 || first_length > rows) {
    return 2;
  }
  using Kernel = QkvgCv<128, 128, 256>;
  Kernel::Arguments arguments{
      reinterpret_cast<uint8_t*>(x),
      reinterpret_cast<uint8_t*>(w),
      reinterpret_cast<uint8_t*>(qk),
      reinterpret_cast<uint8_t*>(v),
      reinterpret_cast<uint8_t*>(gate),
      reinterpret_cast<uint8_t*>(workspace),
      rows,
      reinterpret_cast<uint8_t*>(qw),
      reinterpret_cast<uint8_t*>(kw),
      reinterpret_cast<uint8_t*>(freqs),
      reinterpret_cast<uint8_t*>(prepared_v),
      first_length,
      q_heads,
      kv_heads,
      (q_heads + 2 * kv_heads) * 128 + ((q_heads + 15) / 16) * 16};
  arguments.k_shift = k_shift;
  cv_entry<Kernel><<<24, nullptr, stream>>>(arguments, sync_addr);
  return 0;
}
