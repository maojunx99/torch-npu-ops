#include <cstdint>
#include <type_traits>
#include "catlass/arch/arch.hpp"
#include "catlass/arch/resource.hpp"
#include "catlass/gemm/block/block_mmad.hpp"
#include "catlass/gemm/dispatch_policy.hpp"
#include "catlass/gemm/gemm_type.hpp"
#include "catlass/layout/layout.hpp"

namespace {
template <bool WeightNz>
class NativeOrderBmm {
 public:
  using Arch = Catlass::Arch::AtlasA2;
  using A = Catlass::Gemm::GemmType<bfloat16_t, Catlass::layout::RowMajor>;
  // Native NZ of original [E,N,K] weights is [E,K1,N1,N0,K0].
  // nZ describes that same storage as the logical [K,N] multiplicand.
  using WeightLayout = std::conditional_t<WeightNz, Catlass::layout::nZ,
                                         Catlass::layout::ColumnMajor>;
  using B = Catlass::Gemm::GemmType<bfloat16_t, WeightLayout>;
  using C = Catlass::Gemm::GemmType<bfloat16_t, Catlass::layout::RowMajor>;
  using L1 = Catlass::GemmShape<128, 256, 256>;
  using L0 = Catlass::GemmShape<128, 256, 64>;
  using Policy = Catlass::Gemm::MmadAtlasA2Pingpong<true>;
  using Block = Catlass::Gemm::Block::BlockMmad<Policy, L1, L0, A, B, C>;
  struct Params {
    GM_ADDR x;
    GM_ADDR weight;
    GM_ADDR output;
    int32_t experts, rows, k, n, use_native_order;
  };

  CATLASS_DEVICE uint32_t order(const Params& p, int32_t row,
                                int32_t column) const {
    if (!p.use_native_order) return 0;
    // These are the independently queried installed BatchMatMulV2 tilings
    // for the four frozen component shapes, not the QKV geometry table.
    int32_t extent, index;
    if (p.rows == 1615) {
      extent = 4;
      index = column / (p.n / 4);
    } else {
      extent = 6;
      index = row / 5248;
      // The native last two overlapping M partitions disable shifting.
      if (index >= 4) return 0;
    }
    const uint32_t blocks = p.k / 512;
    const uint32_t offset = (blocks / (extent / 2)) *
                            ((index / 2) % (extent / 2));
    return offset | ((index % 2) ? 256U : 0U);
  }

  CATLASS_DEVICE void operator()(const Params& p) {
    if constexpr (g_coreType == AscendC::AIC) {
      AscendC::GlobalTensor<bfloat16_t> x, weight, output;
      x.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.x));
      weight.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.weight));
      output.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(p.output));
      const Catlass::layout::RowMajor la(p.rows, p.k), lc(p.rows, p.n);
      WeightLayout lb;
      if constexpr (WeightNz) {
        lb = WeightLayout::template MakeLayout<bfloat16_t>(p.k, p.n);
      } else {
        lb = WeightLayout(p.k, p.n);
      }
      const int32_t mt = (p.rows + 127) / 128;
      const int32_t nt = p.n / 256;
      Block block(resource_);
      for (int32_t task = AscendC::GetBlockIdx(); task < p.experts * mt * nt;
           task += AscendC::GetBlockNum()) {
        const int32_t expert = task / (mt * nt);
        const int32_t row = ((task / nt) % mt) * 128;
        const int32_t column = (task % nt) * 256;
        const int32_t rows = p.rows - row < 128 ? p.rows - row : 128;
        block(x[static_cast<int64_t>(expert) * p.rows * p.k +
                static_cast<int64_t>(row) * p.k], la,
              weight[static_cast<int64_t>(expert) * p.k * p.n +
                     lb.GetOffset(Catlass::MatrixCoord{0U, static_cast<uint32_t>(column)})], lb,
              output[static_cast<int64_t>(expert) * p.rows * p.n +
                     static_cast<int64_t>(row) * p.n + column], lc,
              Catlass::GemmCoord{static_cast<uint32_t>(rows), 256U, static_cast<uint32_t>(p.k)}, order(p, row, column));
      }
    }
  }
 private:
  Catlass::Arch::Resource<Arch> resource_;
};

template <class Operation>
__global__ __aicore__ void bmm_entry(typename Operation::Params params) {
  KERNEL_TASK_TYPE_DEFAULT(KERNEL_TYPE_AIC_ONLY);
  Operation operation;
  operation(params);
}
}  // namespace

extern "C" int32_t joyo_native_order_bmm(
    void* x, void* weight, void* output, void* stream,
    int32_t experts, int32_t rows, int32_t k, int32_t n,
    int32_t nz, int32_t native_order) {
  if (!x || !weight || !output || !stream || experts != 3 ||
      (rows != 1615 && rows != 31239) ||
      !((k == 6144 && n == 8192) || (k == 4096 && n == 6144)) ||
      (nz != 0 && nz != 1) || (native_order != 0 && native_order != 1)) return 2;
  if (nz) {
    using Op = NativeOrderBmm<true>;
    Op::Params p{static_cast<uint8_t*>(x), static_cast<uint8_t*>(weight),
                 static_cast<uint8_t*>(output), experts, rows, k, n, native_order};
    bmm_entry<Op><<<24, nullptr, stream>>>(p);
  } else {
    using Op = NativeOrderBmm<false>;
    Op::Params p{static_cast<uint8_t*>(x), static_cast<uint8_t*>(weight),
                 static_cast<uint8_t*>(output), experts, rows, k, n, native_order};
    bmm_entry<Op><<<24, nullptr, stream>>>(p);
  }
  return 0;
}
